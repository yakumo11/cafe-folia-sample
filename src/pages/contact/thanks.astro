---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="お問い合わせ完了 | Cafe Folia">
  <section
    class="flex min-h-[80vh] items-center justify-center px-6 py-32"
  >
    <div
      class="mx-auto max-w-lg text-center bg-white/60 backdrop-blur-sm rounded-3xl p-10 md:p-14 shadow-xl shadow-[#d2bfaa]/20 border border-white/80"
    >
      <p class="text-xs uppercase tracking-[0.35em] text-[#b09073]">
        Thank You
      </p>
      <h1 class="mt-4 font-serif text-2xl text-[#3f241b] md:text-3xl">
        お問い合わせありがとうございました
      </h1>
      <p class="mt-6 text-sm leading-relaxed text-[#7b5a44] md:text-base md:leading-loose">
        内容を確認のうえ、折り返しご連絡いたします。<br />
        しばらくお待ちくださいませ。
      </p>

      <div class="mt-10">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-full bg-[#8b6a54] px-8 py-3 text-sm font-medium text-white shadow-md transition hover:bg-[#7a5d4a]"
        >
          トップページへ戻る
        </a>
      </div>
    </div>
  </section>
</Layout>
